# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` or paste these keys into chat — they belong in the
# Humblytics MCP connection headers, not in conversation or committed files.

# The five live-data skills (cro-optimizer, ab-test-generator, heatmap-analyst,
# revenue-attributor, funnel-reporter) read live data through the Humblytics MCP
# server (https://mcp.humblytics.com/v1). These two values are the credentials
# you pass to that server when you register it — see "Connect in 30 seconds"
# in the README.

# Humblytics API key — sent as the `Authorization: Bearer` header to the MCP.
# Get it from: Humblytics Dashboard > Settings > API. Looks like hmb_...
HUMBLYTICS_API_KEY=your_humblytics_api_key_here

# Humblytics Property ID — sent as the `X-Humblytics-Property-Id` header.
# Found in: Dashboard > Settings > API (same page as the key).
# Optional; with a single-property key the MCP resolves it automatically.
HUMBLYTICS_PROPERTY_ID=

# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` or paste these keys into chat — agents should read them
# from the environment, not from conversation.

# Humblytics API key — required by: cro-optimizer, ab-test-generator,
# heatmap-analyst, revenue-attributor, funnel-reporter.
# Get it from: Humblytics Dashboard > Settings > API
HUMBLYTICS_API_KEY=your_humblytics_api_key_here

# Humblytics Property ID — the property you want the skills to analyze.
# Found in: Dashboard > Settings > API (same page as the key).
# Optional; skills will prompt if unset.
HUMBLYTICS_PROPERTY_ID=
